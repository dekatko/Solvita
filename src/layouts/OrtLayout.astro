---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedServices from '../components/RelatedServices.astro';
import Button from '../components/Button.astro';

interface Props {
  entry: CollectionEntry<'orte'>;
  routeSlug: string;
}

const { entry, routeSlug } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <Breadcrumbs
    items={[
      { label: 'Start', href: '/' },
      { label: entry.data.city, href: `/${routeSlug}/` },
    ]}
  />

  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-semibold text-ink">{entry.data.h1}</h1>
    <p class="mt-4 text-lg text-ink-2">{entry.data.intro}</p>
    <div class="md-content mt-8">
      <Content />
    </div>
  </article>

  <div class="mx-auto max-w-6xl px-4 pb-10 sm:px-6">
    <RelatedServices heading={`Unsere Leistungen in ${entry.data.city}`} count={6} />
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="rounded-[var(--radius-md)] bg-petrol px-6 py-10 text-center text-paper sm:px-10">
      <h2 class="font-display text-2xl font-semibold text-paper">Photovoltaik in {entry.data.city} geplant?</h2>
      <p class="mt-2 text-paper/90">Kostenlose Dachprüfung und Beratung — unverbindlich.</p>
      <Button href="/kontakt/" variant="onDark" class="mt-5">Kontakt aufnehmen</Button>
    </div>
  </div>
</BaseLayout>
