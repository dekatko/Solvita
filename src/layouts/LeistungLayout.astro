---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import HorizonSplit from '../components/HorizonSplit.astro';
import FigureStat from '../components/FigureStat.astro';
import RelatedServices from '../components/RelatedServices.astro';
import Button from '../components/Button.astro';
import QuickLeadForm from '../components/QuickLeadForm.astro';
import { serviceSchema } from '../lib/schema';
import { siteUrl, business } from '../lib/business';

interface Props {
  entry: CollectionEntry<'leistungen'>;
  leadForm?: boolean;
  hero?: { image: ImageMetadata; alt: string };
}

const { entry, leadForm = false, hero } = Astro.props;
const { Content } = await render(entry);
const url = `${siteUrl}/${entry.id}/`;
const schema = serviceSchema({ name: entry.data.h1, description: entry.data.summary, url });
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="border-b border-line bg-paper pb-3">
    <Breadcrumbs
      items={[
        { label: 'Start', href: '/' },
        { label: entry.data.h1, href: `/${entry.id}/` },
      ]}
    />
  </div>

  <HorizonSplit aBackground="ink" bBackground={hero ? 'paper' : 'mist'}>
    <Fragment slot="a">
      <p class="text-sm font-medium uppercase tracking-[var(--tracking-label)] text-sage">Leistung</p>
      <h1 class="mt-4 text-4xl font-semibold leading-[var(--lh-tight)] text-paper">{entry.data.h1}</h1>
      <p class="mt-5 text-lg text-mist">{entry.data.summary}</p>
      <div class="mt-8">
        <Button href="/kontakt/" variant="onDark">Kostenlose Beratung anfragen</Button>
      </div>
    </Fragment>
    <Fragment slot="b">
      {hero ? (
        <Image
          src={hero.image}
          alt={hero.alt}
          width={640}
          height={480}
          loading="eager"
          class="aspect-[4/3] w-full rounded-[var(--radius-md)] object-cover shadow-[var(--shadow)]"
        />
      ) : (
        <div class="grid grid-cols-2 gap-6">
          <FigureStat value="4" label="Regionen: Wolfsburg, Gifhorn, Braunschweig, Helmstedt" />
          <FigureStat value={String(business.foundedCompany)} label="Gründung als Unternehmen" />
        </div>
      )}
    </Fragment>
  </HorizonSplit>

  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <div class="md-content">
      <Content />
    </div>
  </article>

  <div class="border-t border-line bg-mist/50 py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <RelatedServices exclude={entry.id} />
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    {leadForm ? (
      <div class="mx-auto max-w-xl">
        <QuickLeadForm service={entry.data.h1} />
      </div>
    ) : (
      <div class="rounded-[var(--radius-md)] bg-petrol px-6 py-10 text-center text-paper sm:px-10">
        <h2 class="font-display text-2xl font-semibold text-paper">Fragen zu {entry.data.h1}?</h2>
        <p class="mt-2 text-paper/90">Wir beraten Sie kostenlos und unverbindlich.</p>
        <Button href="/kontakt/" variant="onDark" class="mt-5">Kontakt aufnehmen</Button>
      </div>
    )}
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
</BaseLayout>
