---
// Cross-links to /leistungen/ pages. Used on /standorte/* pages (link out
// to services) and on other /leistungen/* pages (link to related services).
import { services } from '../data/services';
import Icon from './Icon.astro';

interface Props {
  currentSlug?: string;
  heading?: string;
  count?: number;
}

const { currentSlug, heading = 'Passende Leistungen', count = 3 } = Astro.props;

const items = services.filter((s) => s.slug !== currentSlug).slice(0, count);
---

<section class="rounded-2xl border border-ink-100 bg-brand-50/40 p-6 sm:p-8">
  <h2 class="text-h3 font-bold text-ink-900">{heading}</h2>
  <ul class="mt-5 grid gap-4 sm:grid-cols-3">
    {items.map((service) => (
      <li>
        <a
          href={`/leistungen/${service.slug}/`}
          class="group flex h-full flex-col rounded-xl bg-white p-4 shadow-sm ring-1 ring-ink-100 transition-shadow hover:shadow-md"
        >
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-100 text-brand-700">
            <Icon name={service.icon} class="h-5 w-5" />
          </span>
          <span class="mt-3 font-semibold text-ink-900 group-hover:text-brand-700">{service.title}</span>
          <span class="mt-1 text-sm text-ink-500">{service.shortDescription}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
