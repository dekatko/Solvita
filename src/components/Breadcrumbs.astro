---
import { breadcrumbSchema } from '../lib/schema';

interface Props {
  items: { label: string; href: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
const schema = breadcrumbSchema(items);
---

<nav aria-label="Breadcrumb" class:list={['mx-auto max-w-6xl px-4 pt-6 text-sm text-zinc sm:px-6', className]}>
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((item, index) => (
      <li class="flex items-center gap-1">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span class="font-medium text-ink" aria-current="page">{item.label}</span>
        ) : (
          <a href={item.href} class="hover:text-petrol">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
