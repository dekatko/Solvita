---
import { nap } from '../data/nap';
import { services } from '../data/services';
import { getCollection } from 'astro:content';

const standorte = await getCollection('standorte');

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${Astro.site}#business`,
  name: nap.legalName,
  image: `${Astro.site}og-default.svg`,
  url: Astro.site?.toString(),
  telephone: nap.phone,
  email: nap.email,
  address: {
    '@type': 'PostalAddress',
    // TODO: confirm exact address/phone/hours before publishing
    streetAddress: nap.street,
    postalCode: nap.postalCode,
    addressLocality: nap.city,
    addressRegion: nap.region,
    addressCountry: nap.country,
  },
  areaServed: nap.serviceArea,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '17:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '10:00',
      closes: '14:00',
    },
  ],
  founder: {
    '@type': 'Person',
    name: nap.founder,
  },
};
---

<footer class="border-t border-ink-100 bg-ink-900 text-ink-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <div>
      <p class="text-lg font-bold text-white">{nap.brandName}</p>
      <p class="mt-3 text-sm leading-relaxed text-ink-300">
        Photovoltaik, Stromspeicher und Gebäudetechnik für {nap.region} — aus {nap.city}, für Privathaushalte, Unternehmen, Landwirte und Kommunen.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Leistungen</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-300">
        {services.map((service) => (
          <li><a href={`/leistungen/${service.slug}/`} class="hover:text-white">{service.title}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Standorte</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-300">
        {standorte.map((standort) => (
          <li><a href={`/standorte/${standort.id}/`} class="hover:text-white">{standort.data.city}</a></li>
        ))}
      </ul>
      <p class="mt-4 text-sm font-semibold text-white">Unternehmen</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-300">
        <li><a href="/ueber-uns/" class="hover:text-white">Über uns</a></li>
        <li><a href="/jobs/" class="hover:text-white">Jobs</a></li>
        <li><a href="/referenzen/" class="hover:text-white">Referenzen</a></li>
        <li><a href="/ratgeber/" class="hover:text-white">Ratgeber</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-white">Kontakt</p>
      <address class="mt-3 space-y-1 text-sm not-italic text-ink-300">
        <p>{nap.legalName}</p>
        <p>{nap.street}</p>
        <p>{nap.postalCode} {nap.city}</p>
        <p class="pt-2"><a href={nap.phoneHref} class="hover:text-white">{nap.phone}</a></p>
        <p><a href={`mailto:${nap.email}`} class="hover:text-white">{nap.email}</a></p>
      </address>
      <a
        href="/kontakt/"
        class="mt-4 inline-block rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-500"
      >
        Kostenlose Beratung anfragen
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-ink-400 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>&copy; {new Date().getFullYear()} {nap.brandName}. Alle Rechte vorbehalten.</p>
      <div class="flex gap-4">
        <a href="/impressum/" class="hover:text-white">Impressum</a>
        <a href="/datenschutz/" class="hover:text-white">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>

<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
