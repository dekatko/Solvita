---
// Cross-links to /standorte/ pages. Used on /leistungen/* pages (link out
// to service areas) and on other /standorte/* pages (link to nearby towns).
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  currentSlug?: string;
  heading?: string;
  count?: number;
}

const { currentSlug, heading = 'Verfügbar in Ihrer Region', count = 4 } = Astro.props;

const allStandorte = await getCollection('standorte');
const items = allStandorte.filter((s) => s.id !== currentSlug).slice(0, count);
---

<section class="rounded-2xl border border-ink-100 bg-sky-50/40 p-6 sm:p-8">
  <h2 class="text-h3 font-bold text-ink-900">{heading}</h2>
  <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((standort) => (
      <li>
        <a
          href={`/standorte/${standort.id}/`}
          class="flex items-center gap-2 rounded-xl bg-white px-4 py-3 shadow-sm ring-1 ring-ink-100 transition-shadow hover:shadow-md"
        >
          <Icon name="pin" class="h-4 w-4 shrink-0 text-brand-600" />
          <span class="font-medium text-ink-800">{standort.data.city}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
