---
// Small inline icon set (no external icon font / JS library) so the site
// ships zero extra requests for iconography.
interface Props {
  name: 'sun' | 'battery' | 'plug' | 'home' | 'box' | 'bolt' | 'check' | 'phone' | 'mail' | 'pin' | 'star';
  class?: string;
}

const { name, class: className = 'w-6 h-6' } = Astro.props;

const paths: Record<Props['name'], string> = {
  sun: 'M12 3v2m0 14v2m9-9h-2M5 12H3m14.95 6.95-1.41-1.41M6.46 6.46 5.05 5.05m13.9 0-1.41 1.41M6.46 17.54l-1.41 1.41M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
  battery: 'M3 8.5A1.5 1.5 0 0 1 4.5 7h11A1.5 1.5 0 0 1 17 8.5v7A1.5 1.5 0 0 1 15.5 17h-11A1.5 1.5 0 0 1 3 15.5v-7Zm16 2v3.5M7 10.5v3',
  plug: 'M9 3v4m6-4v4M7 7h10v3a5 5 0 0 1-5 5 5 5 0 0 1-5-5V7Zm5 8v5m-3 0h6',
  home: 'm3 11 9-8 9 8M5 10v10h5v-6h4v6h5V10',
  box: 'M3 7.5 12 3l9 4.5-9 4.5-9-4.5Zm0 0v9L12 21m0-8.5V21m9-13.5v9L12 21',
  bolt: 'M13 3 4 14h6l-1 7 9-11h-6l1-7Z',
  check: 'm5 13 4 4L19 7',
  phone: 'M4 5c0-1.1.9-2 2-2h2.28a1 1 0 0 1 .98.79l.9 4.05a1 1 0 0 1-.5 1.09l-2 1.1a13.5 13.5 0 0 0 6.3 6.3l1.1-2a1 1 0 0 1 1.09-.5l4.05.9a1 1 0 0 1 .79.98V20a2 2 0 0 1-2 2h-1C10.16 22 2 13.84 2 4V5Z',
  mail: 'M3 6h18v12H3V6Zm0 0 9 7 9-7',
  pin: 'M12 22s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Zm0-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  star: 'm12 3 2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6L12 3Z',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
