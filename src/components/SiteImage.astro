---
// Thin <img> wrapper that makes alt text a required, type-checked prop
// and warns loudly in dev if it's ever passed empty — so missing alt
// text is caught during development, not during a manual review pass.
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, width, height, class: className, loading = 'lazy' } = Astro.props;

if (import.meta.env.DEV && alt.trim() === '') {
  console.warn(`[SiteImage] Missing alt text for image: ${src}`);
}
---

<img src={src} alt={alt} width={width} height={height} class={className} loading={loading} decoding="async" />
