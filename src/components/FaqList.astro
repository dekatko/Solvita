---
// Renders a list of FAQ items as an accordion. Pass a slice of faqItems
// for the homepage teaser, or the full list on /faq/. The consuming page
// is responsible for emitting FAQPage JSON-LD if it wants it.
import type { FaqItem } from '../data/faq';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-ink-100 rounded-2xl border border-ink-100 bg-white">
  {items.map((item, index) => (
    <details class="group px-5 py-4 open:bg-brand-50/30" open={index === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink-900 marker:content-none">
        {item.question}
        <span class="shrink-0 text-brand-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-ink-600" set:html={item.answer.replace(
        /\[(.+?)\]\((.+?)\)/g,
        '<a href="$2" class="font-medium text-brand-700 hover:underline">$1</a>'
      )} />
    </details>
  ))}
</div>
