---
import { getEntry } from 'astro:content';
import LeistungLayout from '../layouts/LeistungLayout.astro';
import heroImage from '../assets/leistungen/wallboxen/hero.jpg';

const entry = await getEntry('leistungen', 'wallboxen');
if (!entry) throw new Error('Missing leistungen entry: wallboxen');
---

<LeistungLayout
  entry={entry}
  hero={{ image: heroImage, alt: 'Wallbox an einer Hauswand mit angeschlossenem Ladekabel neben einem Elektroauto' }}
/>
