---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqList from '../components/FaqList.astro';
import { services } from '../data/services';
import { faqItems } from '../data/faq';
import { getCollection } from 'astro:content';

const standorte = await getCollection('standorte');
const faqTeaser = faqItems.slice(0, 4);
---

<!-- REVIEW: verify facts, pricing, brand names before publishing -->
<Layout
  title="Photovoltaik in Wolfsburg & Niedersachsen"
  description="SolVita plant und installiert Photovoltaikanlagen, Stromspeicher, Wallboxen und Smart-Home-Lösungen in Wolfsburg, Gifhorn, Helmstedt und Braunschweig."
>
  <section class="relative overflow-hidden bg-brand-900">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(79,179,121,0.35),_transparent_55%)]"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-brand-100">
          <Icon name="sun" class="h-4 w-4" /> Photovoltaik aus Wolfsburg
        </p>
        <h1 class="mt-5 text-display font-bold text-white">
          Niedersachsen wird solar — wir machen Ihr Zuhause energieautark
        </h1>
        <p class="mt-5 text-lead text-brand-50">
          SolVita plant, liefert und installiert Photovoltaikanlagen, Stromspeicher, Wallboxen und Smart-Home-Lösungen für Privathaushalte, Unternehmen, Landwirte und Kommunen in Wolfsburg und Niedersachsen — von der ersten Beratung bis zur Inbetriebnahme.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/kontakt/"
            class="rounded-full bg-white px-6 py-3.5 text-center text-sm font-semibold text-brand-800 shadow-sm transition-colors hover:bg-brand-50"
          >
            Kostenlose Beratung anfragen
          </a>
          <a
            href="/leistungen/photovoltaikanlage/"
            class="rounded-full border border-white/30 px-6 py-3.5 text-center text-sm font-semibold text-white transition-colors hover:bg-white/10"
          >
            Leistungen entdecken
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {[
          ['5,34 – 14,4 kWp', 'Anlagengrößen unserer Beispielpakete'],
          ['2–5 Tage', 'reine Montagezeit auf dem Dach'],
          ['4 Regionen', 'Wolfsburg, Gifhorn, Helmstedt, Braunschweig'],
          ['1 Ansprechpartner', 'von der Beratung bis zur Inbetriebnahme'],
        ].map(([stat, label]) => (
          <div class="rounded-2xl bg-white/10 p-5 text-white backdrop-blur">
            <p class="text-2xl font-bold">{stat}</p>
            <p class="mt-1 text-sm text-brand-100">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="text-h1 font-bold text-ink-900">Unsere Leistungen</h2>
      <p class="mt-3 text-ink-600">
        Alles rund um Solarstrom und Gebäudetechnik — geplant und installiert von einem Team aus einer Hand.
      </p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a
          href={`/leistungen/${service.slug}/`}
          class="group flex flex-col rounded-2xl border border-ink-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
        >
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-100 text-brand-700">
            <Icon name={service.icon} class="h-6 w-6" />
          </span>
          <h3 class="mt-4 text-lg font-bold text-ink-900 group-hover:text-brand-700">{service.title}</h3>
          <p class="mt-2 text-sm text-ink-500">{service.shortDescription}</p>
          <span class="mt-4 text-sm font-semibold text-brand-700">Mehr erfahren →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-sky-50/60 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-h1 font-bold text-ink-900">Vor Ort in Ihrer Region</h2>
      <p class="mt-3 max-w-2xl text-ink-600">
        Mit Sitz in Wolfsburg sind wir in ganz Niedersachsen unterwegs — mit besonderem Fokus auf diese Regionen.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {standorte.map((standort) => (
          <a
            href={`/standorte/${standort.id}/`}
            class="flex items-center gap-3 rounded-xl bg-white px-5 py-4 shadow-sm ring-1 ring-ink-100 transition-shadow hover:shadow-md"
          >
            <Icon name="pin" class="h-5 w-5 text-brand-600" />
            <span class="font-semibold text-ink-800">{standort.data.city}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <Testimonials />
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-h1 font-bold text-ink-900">Häufige Fragen</h2>
      <a href="/faq/" class="whitespace-nowrap text-sm font-semibold text-brand-700 hover:underline">
        Alle Fragen ansehen →
      </a>
    </div>
    <div class="mt-8">
      <FaqList items={faqTeaser} />
    </div>
  </section>

  <div class="pb-16">
    <CTA />
  </div>
</Layout>
