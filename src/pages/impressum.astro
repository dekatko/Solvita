---
import Layout from '../layouts/Layout.astro';
import { nap } from '../data/nap';
---

<!-- REVIEW: verify facts, pricing, brand names before publishing -->
<Layout title="Impressum" description="Impressum von SolVita gemäß § 5 TMG." noindex>
  <section class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
    <h1 class="text-h1 font-bold text-ink-900">Impressum</h1>

    <div class="mt-8 space-y-6 text-ink-700">
      <div>
        <h2 class="font-semibold text-ink-900">Angaben gemäß § 5 TMG</h2>
        <p class="mt-1">{nap.legalName}</p>
        <p>{nap.founder}</p>
        <p>{nap.street}</p>
        <p>{nap.postalCode} {nap.city}</p>
      </div>

      <div>
        <h2 class="font-semibold text-ink-900">Kontakt</h2>
        <p class="mt-1">Telefon: {nap.phone}</p>
        <p>E-Mail: {nap.email}</p>
      </div>

      <div>
        <h2 class="font-semibold text-ink-900">Registereintrag</h2>
        <p class="mt-1">{nap.handelsregister}</p>
        <p>{nap.ustId}</p>
      </div>

      <div>
        <h2 class="font-semibold text-ink-900">Verbraucherstreitbeilegung</h2>
        <p class="mt-1">
          Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
        </p>
      </div>
    </div>
  </section>
</Layout>
