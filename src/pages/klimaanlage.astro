---
import { getEntry } from 'astro:content';
import LeistungLayout from '../layouts/LeistungLayout.astro';
import heroImage from '../assets/leistungen/klimaanlage/hero.jpg';

const entry = await getEntry('leistungen', 'klimaanlage');
if (!entry) throw new Error('Missing leistungen entry: klimaanlage');
---

<LeistungLayout
  entry={entry}
  leadForm
  hero={{ image: heroImage, alt: 'Außeneinheit einer installierten Klimaanlage an einer Hauswand' }}
/>
