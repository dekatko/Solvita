---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

const posts = (await getCollection('ratgeber')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<!-- REVIEW: verify facts, pricing, brand names before publishing -->
<Layout
  title="Ratgeber"
  description="Der SolVita-Ratgeber: Verständliche Artikel zu Förderung, Eigenverbrauch und Anlagengröße rund um Photovoltaik in Niedersachsen."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-1.5 text-sm font-medium text-brand-700">
      <Icon name="sun" class="h-4 w-4" /> Ratgeber
    </p>
    <h1 class="mt-4 max-w-2xl text-h1 font-bold text-ink-900">Wissen rund um Photovoltaik</h1>
    <p class="mt-4 max-w-2xl text-lead text-ink-600">
      Verständliche Hintergründe zu Förderung, Anlagengröße und Eigenverbrauch — damit Sie fundierte Entscheidungen für Ihr Zuhause oder Ihr Unternehmen treffen können.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/ratgeber/${post.id}/`}
          class="flex flex-col rounded-2xl border border-ink-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
        >
          <time class="text-xs font-medium uppercase tracking-wide text-ink-400" datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <h2 class="mt-3 text-lg font-bold text-ink-900">{post.data.title}</h2>
          <p class="mt-2 flex-1 text-sm text-ink-500">{post.data.description}</p>
          <span class="mt-4 text-sm font-semibold text-brand-700">Weiterlesen →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
