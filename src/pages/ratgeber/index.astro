---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

// Drafts are buildable at their own URL (for review) but never listed here.
const posts = (await getCollection('ratgeber', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Ratgeber: Photovoltaik verständlich erklärt"
  description="Der SolVita-Ratgeber: verständliche Artikel zu Förderung, Speichergröße, Baugenehmigung und mehr rund um Photovoltaik in Niedersachsen — ohne Verkaufssprache."
>
  <Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: 'Ratgeber', href: '/ratgeber/' }]} />

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-semibold text-ink">Ratgeber</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-2">
      Verständliche Hintergründe zu Photovoltaik, Speicher und Förderung — damit Sie fundierte Entscheidungen treffen können.
    </p>

    {posts.length === 0 ? (
      <p class="mt-10 text-ink-2">Hier entstehen in Kürze weitere Artikel.</p>
    ) : (
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/ratgeber/${post.id}/`}
            class="flex flex-col rounded-[var(--radius-md)] border border-line bg-paper p-6 shadow-[var(--shadow)] transition-shadow hover:shadow-[0_1px_2px_rgba(20,37,35,.06),_0_16px_40px_-20px_rgba(20,37,35,.5)]"
          >
            <h2 class="text-lg font-semibold text-ink">{post.data.h1}</h2>
            <p class="mt-2 flex-1 text-sm text-zinc">{post.data.description}</p>
            <span class="mt-4 text-sm font-semibold text-petrol">Weiterlesen →</span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
