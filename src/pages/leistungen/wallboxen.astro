---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ServiceLinks from '../../components/ServiceLinks.astro';
import LocationLinks from '../../components/LocationLinks.astro';
import CTA from '../../components/CTA.astro';

const steps = [
  { title: 'Beratung', text: 'Wir besprechen verfügbare Modelle und die passende Ladeleistung für Ihr Fahrzeug.' },
  { title: 'Installation', text: 'Fachgerechte Montage und elektrischer Anschluss durch unser Team.' },
  { title: 'Inbetriebnahme', text: 'Aktivierung und Einweisung in die Ladesteuerung.' },
];
---

<!-- REVIEW: verify facts, pricing, brand names before publishing -->
<Layout
  title="Wallboxen"
  description="Wallbox-Installation in Niedersachsen: Elektrofahrzeuge intelligent mit selbst erzeugtem Solarstrom laden. Planung, Lieferung und Installation von SolVita."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-1.5 text-sm font-medium text-brand-700">
      <Icon name="plug" class="h-4 w-4" /> Leistung
    </p>
    <h1 class="mt-4 max-w-3xl text-h1 font-bold text-ink-900">
      Wallboxen: Ihr Elektrofahrzeug mit eigenem Solarstrom laden
    </h1>
    <p class="mt-4 max-w-2xl text-lead text-ink-600">
      Mit einer Wallbox laden Sie Ihr Elektrofahrzeug bevorzugt mit selbst erzeugtem Solarstrom, statt teuren Netzstrom zu beziehen. Unsere Lösungen sind mit gängigen Elektrofahrzeugmodellen und dem Typ-2-Ladestandard kompatibel.
    </p>

    <div class="mt-12 grid gap-5 sm:grid-cols-3">
      {steps.map((step, index) => (
        <div class="rounded-2xl border border-ink-100 bg-white p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
            {index + 1}
          </span>
          <h3 class="mt-3 font-semibold text-ink-900">{step.title}</h3>
          <p class="mt-1 text-sm text-ink-500">{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-brand-50/50 py-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="text-h2 font-bold text-ink-900">Intelligentes Laden mit Solarstrom</h2>
      <p class="mt-3 text-ink-600">
        In Kombination mit Ihrer <a href="/leistungen/photovoltaikanlage/" class="font-medium text-brand-700 hover:underline">Photovoltaikanlage</a> und optional einem <a href="/leistungen/stromspeicher/" class="font-medium text-brand-700 hover:underline">Stromspeicher</a> lädt eine intelligent gesteuerte Wallbox Ihr Fahrzeug bevorzugt dann, wenn ausreichend Solarstrom zur Verfügung steht — und reduziert so Ihre Ladekosten spürbar. [Preis auf Anfrage]
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <LocationLinks heading="Wallbox-Installation in Ihrer Region" />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6">
    <ServiceLinks currentSlug="wallboxen" heading="Gut kombinierbar mit" />
  </section>

  <div class="pb-16">
    <CTA heading="Wallbox für Ihr Elektrofahrzeug?" text="Wir beraten Sie kostenlos zu Modell, Ladeleistung und Installation." />
  </div>
</Layout>
