---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ServiceLinks from '../../components/ServiceLinks.astro';
import LocationLinks from '../../components/LocationLinks.astro';
import CTA from '../../components/CTA.astro';

const features = [
  { title: 'Zentrale Steuerung', text: 'PV-Anlage, Stromspeicher und Verbraucher intelligent miteinander vernetzt.' },
  { title: 'Geräte- und Verbrauchssteuerung', text: 'Beleuchtung, Heizung und Ladestationen lassen sich zentral steuern.' },
  { title: 'App oder Bedieneinheit', text: 'Bedienung wahlweise per App oder über eine feste Steuereinheit im Haus.' },
  { title: 'Einrichtung & Einweisung', text: 'Wir konfigurieren das System und weisen Sie in die Bedienung ein.' },
];
---

<!-- REVIEW: verify facts, pricing, brand names before publishing -->
<Layout
  title="Smart Home"
  description="Smart-Home-Lösungen in Niedersachsen: Photovoltaikanlage, Stromspeicher und Verbraucher intelligent vernetzt — Einrichtung und Support von SolVita."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-1.5 text-sm font-medium text-brand-700">
      <Icon name="home" class="h-4 w-4" /> Leistung
    </p>
    <h1 class="mt-4 max-w-3xl text-h1 font-bold text-ink-900">
      Smart Home: Ihre Energie intelligent vernetzt
    </h1>
    <p class="mt-4 max-w-2xl text-lead text-ink-600">
      Eine Smart-Home-Lösung ist die zentrale Schaltstelle, die Ihre Photovoltaikanlage, Ihren Stromspeicher und Ihre Verbraucher intelligent miteinander vernetzt — für mehr Komfort und einen höheren Anteil an selbst genutztem Solarstrom.
    </p>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {features.map((feature) => (
        <div class="flex gap-4 rounded-2xl border border-ink-100 bg-white p-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
            <Icon name="check" class="h-5 w-5" />
          </span>
          <div>
            <h3 class="font-semibold text-ink-900">{feature.title}</h3>
            <p class="mt-1 text-sm text-ink-500">{feature.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-brand-50/50 py-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="text-h2 font-bold text-ink-900">Mehr aus Ihrer Anlage herausholen</h2>
      <p class="mt-3 text-ink-600">
        Smart-Home-Steuerung ergibt besonders in Kombination mit einer <a href="/leistungen/photovoltaikanlage/" class="font-medium text-brand-700 hover:underline">Photovoltaikanlage</a>, einem <a href="/leistungen/stromspeicher/" class="font-medium text-brand-700 hover:underline">Stromspeicher</a> und einer <a href="/leistungen/wallboxen/" class="font-medium text-brand-700 hover:underline">Wallbox</a> Sinn: Verbraucher lassen sich automatisch in Zeiten mit hoher Solarstromproduktion verschieben. [TODO: eingesetzte Smart-Home-Plattform/Marke vor Veröffentlichung bestätigen]
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <LocationLinks heading="Smart-Home-Einrichtung in Ihrer Region" />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6">
    <ServiceLinks currentSlug="smart-home" heading="Gut kombinierbar mit" />
  </section>

  <div class="pb-16">
    <CTA heading="Ihr Zuhause smarter machen?" text="Wir zeigen Ihnen, wie sich Ihre Energieerzeugung und -nutzung intelligent vernetzen lässt." />
  </div>
</Layout>
