---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ServiceLinks from '../../components/ServiceLinks.astro';
import LocationLinks from '../../components/LocationLinks.astro';
import CTA from '../../components/CTA.astro';

const offerings = [
  { title: 'Elektroinstallation', text: 'Haushaltsnahe Elektroinstallation für Neubau, Sanierung und Erweiterung.' },
  { title: 'Wärmepumpen', text: 'Beratung und Installation als Ergänzung zu Ihrer Photovoltaikanlage.' },
  { title: 'Gebäudetechnik', text: 'Weitere haustechnische Systeme rund um Energieerzeugung und -verbrauch.' },
];
---

<!-- REVIEW: verify facts, pricing, brand names before publishing -->
<Layout
  title="Energie- und Gebäudetechnik"
  description="Elektroinstallation, Wärmepumpen und Gebäudetechnik in Niedersachsen — als Ergänzung zu Photovoltaik, Speicher und Wallbox, aus einer Hand von SolVita."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-1.5 text-sm font-medium text-brand-700">
      <Icon name="bolt" class="h-4 w-4" /> Leistung
    </p>
    <h1 class="mt-4 max-w-3xl text-h1 font-bold text-ink-900">
      Energie- und Gebäudetechnik aus einer Hand
    </h1>
    <p class="mt-4 max-w-2xl text-lead text-ink-600">
      Neben Photovoltaik, Speicher und Wallbox übernehmen wir als Elektrofachbetrieb auch die klassische Elektroinstallation sowie Wärmepumpen und weitere Gebäudetechnik — damit Energieerzeugung und Gebäudetechnik bei Ihnen zu Hause zusammenpassen.
    </p>

    <div class="mt-12 grid gap-5 sm:grid-cols-3">
      {offerings.map((offering) => (
        <div class="rounded-2xl border border-ink-100 bg-white p-5">
          <h3 class="font-semibold text-ink-900">{offering.title}</h3>
          <p class="mt-2 text-sm text-ink-500">{offering.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-brand-50/50 py-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="text-h2 font-bold text-ink-900">Warum Elektrotechnik und Solar zusammen denken</h2>
      <p class="mt-3 text-ink-600">
        Eine Wärmepumpe oder eine neue Elektroinstallation lässt sich direkt auf eine geplante oder bestehende <a href="/leistungen/photovoltaikanlage/" class="font-medium text-brand-700 hover:underline">Photovoltaikanlage</a> abstimmen — für einen höheren Eigenverbrauch und geringere Betriebskosten über die gesamte Nutzungsdauer. [Preis auf Anfrage]
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <LocationLinks heading="Verfügbar in" />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6">
    <ServiceLinks currentSlug="energie-gebaeudetechnik" heading="Weitere Leistungen" />
  </section>

  <div class="pb-16">
    <CTA heading="Elektro- oder Gebäudetechnik-Projekt geplant?" text="Sprechen Sie mit uns über Ihr Vorhaben — unverbindlich und kostenlos." />
  </div>
</Layout>
