---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ServiceLinks from '../../components/ServiceLinks.astro';
import LocationLinks from '../../components/LocationLinks.astro';
import CTA from '../../components/CTA.astro';

const benefits = [
  { title: 'Höherer Eigenverbrauch', text: 'Tagsüber erzeugter Überschuss wird gespeichert statt günstig eingespeist.' },
  { title: 'Unabhängigkeit von Preisschwankungen', text: 'Weniger Abhängigkeit vom öffentlichen Netz und steigenden Strompreisen.' },
  { title: 'Abend- und Nachtversorgung', text: 'Gespeicherter Solarstrom deckt einen Teil des Verbrauchs, wenn die Sonne nicht scheint.' },
  { title: 'Kombinierbar mit Wallbox', text: 'Elektrofahrzeuge lassen sich bevorzugt mit gespeichertem Solarstrom laden.' },
];
---

<!-- REVIEW: verify facts, pricing, brand names before publishing -->
<Layout
  title="Stromspeicher"
  description="Stromspeicher für Photovoltaikanlagen in Niedersachsen: mehr Eigenverbrauch, mehr Unabhängigkeit von steigenden Strompreisen — Beratung und Installation von SolVita."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-1.5 text-sm font-medium text-brand-700">
      <Icon name="battery" class="h-4 w-4" /> Leistung
    </p>
    <h1 class="mt-4 max-w-3xl text-h1 font-bold text-ink-900">
      Stromspeicher: nie wieder abhängig von steigenden Preisen
    </h1>
    <p class="mt-4 max-w-2xl text-lead text-ink-600">
      Ein Stromspeicher speichert den tagsüber von Ihrer Photovoltaikanlage erzeugten Überschuss, den Sie in dem Moment nicht verbrauchen, und stellt ihn abends und nachts wieder zur Verfügung. Das erhöht Ihren Eigenverbrauchsanteil deutlich und macht Sie unabhängiger vom öffentlichen Netz.
    </p>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {benefits.map((benefit) => (
        <div class="flex gap-4 rounded-2xl border border-ink-100 bg-white p-5">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
            <Icon name="check" class="h-5 w-5" />
          </span>
          <div>
            <h3 class="font-semibold text-ink-900">{benefit.title}</h3>
            <p class="mt-1 text-sm text-ink-500">{benefit.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-brand-50/50 py-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="text-h2 font-bold text-ink-900">Welche Speichergröße passt zu mir?</h2>
      <p class="mt-3 text-ink-600">
        Die passende Kapazität hängt von Ihrem Verbrauchsprofil, der Größe Ihrer Photovoltaikanlage und geplanten Zusatzverbrauchern wie einer Wallbox oder Wärmepumpe ab. In unseren Beispielpaketen zur <a href="/leistungen/photovoltaikanlage/" class="font-medium text-brand-700 hover:underline">Photovoltaikanlage</a> sind Speicher von rund 6 bis 10 kWh bereits enthalten oder optional nachrüstbar — inklusive bis zu 15 Jahren Speichergarantie bei größeren Systemen. [Preis auf Anfrage]
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <LocationLinks heading="Stromspeicher-Installation in Ihrer Region" />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6">
    <ServiceLinks currentSlug="stromspeicher" heading="Gut kombinierbar mit" />
  </section>

  <div class="pb-16">
    <CTA heading="Lohnt sich ein Speicher für Sie?" text="Wir berechnen unverbindlich, wie viel Eigenverbrauch ein Speicher für Ihr Zuhause zusätzlich ermöglicht." />
  </div>
</Layout>
