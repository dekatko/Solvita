---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ServiceLinks from '../../components/ServiceLinks.astro';
import LocationLinks from '../../components/LocationLinks.astro';
import CTA from '../../components/CTA.astro';
import Testimonials from '../../components/Testimonials.astro';

const packages = [
  { name: 'Basis', kwp: '5,34 kWp', detail: '12 Solarmodule, Wechselrichter, optional Speicher nachrüstbar' },
  { name: 'Komfort', kwp: '7,12 kWp', detail: '16 Solarmodule, Batteriespeicher mit 6,14 kWh Kapazität' },
  { name: 'Effizient', kwp: '10,8 kWp', detail: '24 Solarmodule, Stromspeicher mit 10 kWh Kapazität, 15 Jahre Speichergarantie' },
  { name: 'Voll-Autark', kwp: '14,4 kWp', detail: '32 Solarmodule, großzügig dimensioniertes Speichersystem, 15 Jahre Speichergarantie' },
];

const steps = [
  { title: 'Beratung & Bedarfsanalyse', text: 'Wir analysieren Ihren Stromverbrauch, Ihre Dachfläche und Ihre Ziele.' },
  { title: 'Planung', text: 'Wir legen Anlagengröße, Komponenten und ggf. Speicher passgenau für Ihr Gebäude aus.' },
  { title: 'Installation', text: 'Unser Team montiert Module, Unterkonstruktion und Wechselrichter fachgerecht.' },
  { title: 'Inbetriebnahme', text: 'Anmeldung beim Netzbetreiber, Aktivierung und Einweisung in die App-Überwachung.' },
];
---

<!-- REVIEW: verify facts, pricing, brand names before publishing -->
<Layout
  title="Photovoltaikanlage"
  description="Photovoltaikanlagen für Privathaushalte und Unternehmen in Niedersachsen: Beratung, Planung, Installation und Inbetriebnahme aus einer Hand — von SolVita."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-1.5 text-sm font-medium text-brand-700">
      <Icon name="sun" class="h-4 w-4" /> Leistung
    </p>
    <h1 class="mt-4 max-w-3xl text-h1 font-bold text-ink-900">
      Photovoltaikanlage: Solarstrom vom eigenen Dach
    </h1>
    <p class="mt-4 max-w-2xl text-lead text-ink-600">
      Eine Photovoltaikanlage wandelt Sonnenlicht über Solarmodule direkt in elektrischen Strom um. Ein Wechselrichter macht daraus nutzbaren Haushaltsstrom — für den direkten Verbrauch, zur Speicherung oder zur Einspeisung ins öffentliche Netz. SolVita übernimmt für Sie Beratung, Planung, Installation und Inbetriebnahme aus einer Hand.
    </p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <div class="rounded-2xl border border-ink-100 bg-white p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
            {index + 1}
          </span>
          <h3 class="mt-3 font-semibold text-ink-900">{step.title}</h3>
          <p class="mt-1 text-sm text-ink-500">{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-brand-50/50 py-14">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-h1 font-bold text-ink-900">Unsere Beispielpakete</h2>
      <p class="mt-3 max-w-2xl text-ink-600">
        Als Orientierung — die für Sie passende Anlagengröße hängt von Verbrauch, Dachfläche und Ihren Zielen ab und wird individuell mit Ihnen abgestimmt. [Preis auf Anfrage]
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {packages.map((pkg) => (
          <div class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-ink-100">
            <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">{pkg.name}</p>
            <p class="mt-2 text-2xl font-bold text-ink-900">{pkg.kwp}</p>
            <p class="mt-3 flex-1 text-sm text-ink-500">{pkg.detail}</p>
          </div>
        ))}
      </div>
      <p class="mt-4 text-sm text-ink-400">
        Beispielkomponenten u. a. von Huawei, Deye und EcoFlow — je nach Verfügbarkeit und Projekt können andere gleichwertige Fabrikate zum Einsatz kommen. [TODO: aktuelle Markenpartner vor Veröffentlichung bestätigen]
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-h2 font-bold text-ink-900">Baugenehmigung & Aufwand</h2>
        <p class="mt-3 text-ink-600">
          Für bestehende Wohngebäude ist in Niedersachsen in der Regel keine gesonderte Baugenehmigung nötig — Ausnahmen bilden etwa denkmalgeschützte Gebäude. Wir prüfen das für Sie vorab. Die reine Montage auf dem Dach dauert bei einem durchschnittlichen Einfamilienhaus meist 2 bis 5 Tage; das Gesamtprojekt bis zur Inbetriebnahme kann je nach Genehmigungen und Netzanschluss mehrere Wochen in Anspruch nehmen.
        </p>
      </div>
      <div>
        <h2 class="text-h2 font-bold text-ink-900">Garantie & Support</h2>
        <p class="mt-3 text-ink-600">
          Die verbauten Komponenten tragen Herstellergarantien — üblich sind rund 10 bis 25 Jahre auf Solarmodule und 5 bis 10 Jahre auf Wechselrichter, teils länger auf Speichersysteme. Optional bieten wir Wartungsverträge an. Details besprechen wir in Ihrem individuellen Angebot.
        </p>
      </div>
    </div>
  </section>

  <section class="py-14">
    <Testimonials heading="Was Kundinnen und Kunden über unsere PV-Installationen sagen" />
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <LocationLinks heading="Photovoltaik-Installation in Ihrer Region" />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6">
    <ServiceLinks currentSlug="photovoltaikanlage" heading="Gut kombinierbar mit" />
  </section>

  <div class="pb-16">
    <CTA heading="Passt eine PV-Anlage zu Ihrem Dach?" text="Wir prüfen kostenlos, welche Anlagengröße für Sie sinnvoll ist." />
  </div>
</Layout>
