---
import Layout from '../layouts/Layout.astro';
import FaqList from '../components/FaqList.astro';
import CTA from '../components/CTA.astro';
import { faqItems } from '../data/faq';

// Strip Markdown links for the JSON-LD text (structured data should be plain text).
const plainAnswer = (answer: string) => answer.replace(/\[(.+?)\]\(.+?\)/g, '$1');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: plainAnswer(item.answer),
    },
  })),
};
---

<!-- REVIEW: verify facts, pricing, brand names before publishing -->
<Layout
  title="Häufige Fragen zu Photovoltaik"
  description="Antworten auf häufige Fragen zu Photovoltaikanlagen, Stromspeichern, Baugenehmigungen, Förderung und Garantien — beantwortet von SolVita."
>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="text-h1 font-bold text-ink-900">Häufige Fragen</h1>
    <p class="mt-4 text-lead text-ink-600">
      Antworten auf die Fragen, die uns Kundinnen und Kunden am häufigsten zu Photovoltaik, Speicher und Förderung stellen.
    </p>
    <div class="mt-10">
      <FaqList items={faqItems} />
    </div>
  </section>

  <div class="pb-16">
    <CTA heading="Ihre Frage war nicht dabei?" text="Schreiben oder rufen Sie uns an — wir beantworten sie gerne persönlich." />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
