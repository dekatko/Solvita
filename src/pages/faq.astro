---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import RelatedServices from '../components/RelatedServices.astro';
import { faqItems } from '../lib/faq';
---

<BaseLayout
  title="Photovoltaik FAQ: Kosten, Technik, Förderung"
  description="Die 15 häufigsten Fragen zu Photovoltaik, Speicher und Einspeisung — kurz beantwortet vom Fachbetrieb, ohne Verkaufssprache und ohne Fachchinesisch."
>
  <Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: 'FAQ', href: '/faq/' }]} />

  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-semibold text-ink">Häufige Fragen</h1>
    <p class="mt-4 text-lg text-ink-2">
      Antworten auf die 15 Fragen, die uns am häufigsten zu Photovoltaik, Speicher und Einspeisung gestellt werden.
    </p>
    <div class="mt-8">
      <Faq items={faqItems} />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <RelatedServices heading="Unsere Leistungen" count={3} />
  </section>
</BaseLayout>
